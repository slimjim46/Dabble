# Dabble environment — variable names only, no values.
#
# Copy to .env (git-ignored) and fill in. Real values belong in .env, the Vercel
# project settings and the Supabase dashboard — never in git, never in a log.
# Everything starting with VITE_ is baked into the public bundle, so only the
# Supabase URL and the anon key may appear there: put nothing secret in a name
# that starts with VITE_.

# --- client build (public by definition) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- build time (read by vite.config.js) ---
# Absolute site origin, used for og:image; without it those tags are dropped.
VITE_SITE_URL=

# --- optional client settings ---
VITE_TURNSTILE_SITE_KEY=
VITE_OWNER_NAME=
VITE_OWNER_URL=
VITE_PRIVACY_URL=

# --- server (Vercel functions in api/, GitHub Actions) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- local scripts: scripts/render-snapshot.mjs and the dev test suites ---
# (same SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY as above)

# --- local only: scripts/loadtest.mjs refuses to run without the first one ---
LOADTEST_ALLOWED_URL=
LOADTEST_CLIENTS=
LOADTEST_DURATION_MS=
